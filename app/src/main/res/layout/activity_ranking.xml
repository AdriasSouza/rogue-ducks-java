<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/bg_dark"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TOP 10 RANKING"
        style="@style/RogueDucks.Text.Title"
        android:textSize="28sp"
        android:layout_marginBottom="24dp" />

    <ListView
        android:id="@+id/lvRanking"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/bg_dark_card"
        android:dividerHeight="2dp"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnBack"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:text="Voltar ao Menu"
        style="@style/RogueDucks.Button"
        android:backgroundTint="@color/secondary_red" />

</LinearLayout>